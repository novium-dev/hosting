data_dir = "/var/lib/novium-database-agent/data"
socket_dir = "/run/novium-database-agent"

# Disk usage is rescanned per instance on this interval (seconds); an instance
# over its limit is stopped. `disk_check_concurrency` caps parallel scans.
disk_check_interval = 60
disk_check_concurrency = 5

# Instances that were last started through the agent and not stopped since are
# started again on boot, this many at a time. 0 disables the restore.
boot_autostart_concurrency = 5

# The agent normally writes this file itself during setup (`--setup-url` /
# `--setup-token`), together with agent_root.pem and agent.pem. It is kept here
# as a reference for the values setup cannot know.

# The backend talks to this API over mTLS: the agent serves agent.pem and only
# accepts clients whose certificate was signed by the CA in agent_root.pem.
# `public_url` is the base URL the backend calls back on, and its host is what
# the backend registered the host under.
[api]
bind = "0.0.0.0:8090"
public_url = "https://db-eu-1.example.com:8090"

[store]
url = "sqlite:///var/lib/novium-database-agent/data/agent.db?mode=rwc"

[docker]
socket = "/var/run/docker.sock"
tmpfs_size = 100
container_pid_limit = 512
rootless = false
log_driver = "local"

# [docker.registries."ghcr.io"]
# username = "<username>"
# password = "<password>"

# One shared listener per engine. Instances stay on unix sockets with
# `network_mode: none`; clients connect here as `u<8 hex>_<label>` and the agent
# proxies them to the instance that owns the user.
[postgres]
enabled = true
bind = "0.0.0.0:5432"

[mariadb]
enabled = true
bind = "0.0.0.0:3306"

[mongodb]
enabled = true
bind = "0.0.0.0:27017"

[redis]
enabled = true
bind = "0.0.0.0:6379"

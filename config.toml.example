listeners = ["[::]:8080"]
public_url = "http://localhost:8080"
database_url = "postgres://postgres:postgres@localhost/backend"
cache_url = "valkey://localhost?protocol=resp3"
trusted_urls = ["http://localhost:3000", "http://localhost:3001"]

# In seconds (= 60*24*30, 30 days)
session_lifetime = 43200

# Skip refreshing the template caches (existing caches are used as-is, missing
# ones are still generated once). Also settable via
# BACKEND_SKIP_TEMPLATE_CACHE_UPDATE=1
skip_template_cache_update = true

# Mod/plugin providers. Modrinth, Hangar and SpigotMC need no credentials;
# CurseForge requires a Core API key (https://console.curseforge.com) and stays
# disabled without one. Also settable via BACKEND_CURSEFORGE_API_KEY.
[resources]
curseforge_api_key = "<curseforge_api_key>"

# Routes (subdomains). Domains are registered in the admin UI; the route kind
# follows the port: TCP ports get a Cloudflare SRV record, ports marked as HTTP
# become Pangolin resources. A backend that is not configured here disables the
# route kind it carries.
[routes.cloudflare]
api_token = "<api_token>"
# zone_id = ""
# ttl = 60

[routes.pangolin]
api_url = "https://api.gateway.novium.world/v1"
api_key = "<api_key>"
org_id = "novium"
site_id = 1

# Only relevant if the "embedded_node" feature is set
[daemon]
url = "https://localhost:3001"

[auth.providers.user]
auth_url = "https://sso.novium.world/oidc/auth"
token_url = "https://sso.novium.world/oidc/token"
redirect_url = "http://localhost:8080/api/auth/callback"
userinfo_url = "https://sso.novium.world/oidc/me"
client_id = "<client_id>"
client_secret = "<client_secret>"

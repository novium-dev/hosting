# The backend is configured entirely from the environment; there is no config file.
# BACKEND_DATA_DIR (default ".") only decides where the generated keys live.
# Debug builds load a .env from the working directory upwards before reading the
# environment (copy this file to .env); release builds never read one.

# Comma-separated socket addresses to listen on. Plain HTTP - terminate TLS upstream.
BACKEND_LISTENERS=[::]:8080

# Public origin browsers reach the panel on. Decides the session cookie's Secure
# flag and the allowed origin for the CSRF check.
BACKEND_PUBLIC_URL=https://panel.example.com

# Extra origins allowed to make cookie-authenticated writes (comma-separated).
BACKEND_TRUSTED_URLS=http://localhost:3000,http://localhost:3001

# Session TTL in seconds. Default 43200 (12 hours).
BACKEND_SESSION_LIFETIME=43200

BACKEND_DATABASE_URL=postgres://postgres:postgres@postgres/backend
BACKEND_CACHE_URL=valkey://valkey?protocol=resp3

# Use the existing template caches as-is instead of refreshing them at startup.
BACKEND_SKIP_TEMPLATE_CACHE_UPDATE=0

# OAuth/OIDC. BACKEND_AUTH_PROVIDER names the provider in the login route
# (/api/auth/login/<name>) and must match the frontend's VITE_PROVIDERS.
BACKEND_AUTH_PROVIDER=user
BACKEND_AUTH_AUTHORIZE_URL=https://sso.novium.world/oidc/auth
BACKEND_AUTH_TOKEN_URL=https://sso.novium.world/oidc/token
BACKEND_AUTH_REDIRECT_URL=https://panel.example.com/api/auth/callback
BACKEND_AUTH_USERINFO_URL=https://sso.novium.world/oidc/me
BACKEND_AUTH_CLIENT_ID=<client_id>
BACKEND_AUTH_CLIENT_SECRET=<client_secret>

# Logto role mapping. Comma-separated Logto role names (matched case-insensitively)
# that grant the panel's Admin/Moderator role; everyone else becomes a User.
# Requires the `roles` scope, which the login route requests. Leaving both unset
# disables the mapping entirely and leaves roles to the admin UI.
BACKEND_AUTH_ADMIN_ROLES=
BACKEND_AUTH_MODERATOR_ROLES=

# Mod/plugin providers. Modrinth, Hangar and SpigotMC need no credentials;
# CurseForge requires a Core API key (https://console.curseforge.com) and stays
# disabled without one.
BACKEND_CURSEFORGE_API_KEY=

# Routes (subdomains). Domains are registered in the admin UI; the route kind
# follows the port: TCP ports get a Cloudflare SRV record, ports marked as HTTP
# become Pangolin resources. Leave a block unset to disable that route kind.
# Cloudflare is enabled by the presence of the API token.
BACKEND_CLOUDFLARE_API_TOKEN=
BACKEND_CLOUDFLARE_TTL=60
BACKEND_CLOUDFLARE_API_URL=

# Pangolin is enabled by the presence of the API url; the other three are then required.
BACKEND_PANGOLIN_API_URL=
BACKEND_PANGOLIN_API_KEY=
BACKEND_PANGOLIN_ORG_ID=
BACKEND_PANGOLIN_SITE_ID=

# Database instances projects create for themselves. Every engine is available
# with built-in defaults (image, uid/gid, socket path, volumes, command - see
# InstanceDefaults::builtin in backend/src/config.rs). Only the image and the
# resource limits are configurable; memory/swap/disk are MiB, cpu is a
# percentage of one core. Set <ENGINE>_ENABLED=false to disable an engine.
# Engines: POSTGRES, MARIADB, MONGODB, REDIS.
BACKEND_DB_POSTGRES_ENABLED=true
BACKEND_DB_POSTGRES_IMAGE=postgres:18-alpine
BACKEND_DB_POSTGRES_MEMORY=1024
BACKEND_DB_POSTGRES_SWAP=0
BACKEND_DB_POSTGRES_DISK=10240
BACKEND_DB_POSTGRES_CPU=100

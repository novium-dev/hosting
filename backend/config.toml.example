listeners = ["[::]:8080"]
public_url = "http://localhost:8080"
database_url = "postgres://postgres:postgres@localhost/backend"
cache_url = "valkey://localhost?protocol=resp3"
trusted_urls = ["http://localhost:3000", "http://localhost:3001"]

# In seconds (= 60*24*30, 30 days)
session_lifetime = 43200

# Skip refreshing the template caches (existing caches are used as-is, missing
# ones are still generated once). Also settable via
# BACKEND_SKIP_TEMPLATE_CACHE_UPDATE=1
skip_template_cache_update = true

# Mod/plugin providers. Modrinth, Hangar and SpigotMC need no credentials;
# CurseForge requires a Core API key (https://console.curseforge.com) and stays
# disabled without one. Also settable via BACKEND_CURSEFORGE_API_KEY.
[resources]
curseforge_api_key = "<curseforge_api_key>"

# Routes (subdomains). Domains are registered in the admin UI; the route kind
# follows the port: TCP ports get a Cloudflare SRV record, ports marked as HTTP
# become Pangolin resources. A backend that is not configured here disables the
# route kind it carries.
[routes.cloudflare]
api_token = "<api_token>"
# zone_id = ""
# ttl = 60

[routes.pangolin]
api_url = "https://api.gateway.novium.world/v1"
api_key = "<api_key>"
org_id = "novium"
site_id = 1

# Only relevant if the "embedded_node" feature is set
[daemon]
url = "https://localhost:3001"

[auth.providers.user]
auth_url = "https://sso.novium.world/oidc/auth"
token_url = "https://sso.novium.world/oidc/token"
redirect_url = "http://localhost:8080/api/auth/callback"
userinfo_url = "https://sso.novium.world/oidc/me"
client_id = "<client_id>"
client_secret = "<client_secret>"

# Shape of the database instances projects create for themselves. They pick only
# the engine, so everything the agent needs to run the container comes from
# here. An engine without a defaults block cannot be created.
#
# `socket_path` is where the engine puts its unix socket inside the container;
# the agent bind-mounts that directory and reaches the engine through it. The
# memory, swap and disk limits are MiB, cpu is a percentage of one core.
[databases.defaults.postgres]
image = "postgres:18-alpine"
image_uid = 70
image_gid = 70
socket_path = "/var/run/postgresql/.s.PGSQL.5432"
memory = 1024
swap = 0
disk = 10240
cpu = 100
volumes = { data = "/var/lib/postgresql" }
env = { POSTGRES_HOST_AUTH_METHOD = "trust", PGDATA = "/var/lib/postgresql/data" }

[databases.defaults.mariadb]
image = "mariadb:11"
image_uid = 999
image_gid = 999
socket_path = "/run/mysqld/mysqld.sock"
memory = 1024
swap = 0
disk = 10240
cpu = 100
volumes = { data = "/var/lib/mysql" }
env = { MARIADB_ALLOW_EMPTY_ROOT_PASSWORD = "1" }

# mongod only enforces authorization with --auth, and the agent refuses to relay
# to an instance that does not.
[databases.defaults.mongodb]
image = "mongo:8"
image_uid = 999
image_gid = 999
socket_path = "/run/mongodb/mongodb-27017.sock"
memory = 1024
swap = 0
disk = 10240
cpu = 100
volumes = { data = "/data/db" }
cmd = ["mongod", "--auth", "--unixSocketPrefix=/run/mongodb"]

[databases.defaults.redis]
image = "redis:8-alpine"
image_uid = 999
image_gid = 999
socket_path = "/run/redis/redis.sock"
memory = 512
swap = 0
disk = 2048
cpu = 100
volumes = { data = "/data" }
cmd = ["redis-server", "--unixsocket", "/run/redis/redis.sock", "--port", "0"]

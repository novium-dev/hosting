# Host both the SPA and the API are served from. Traefik sends /api/* to the
# backend and everything else to the SPA, so they stay same-origin and the
# session cookie keeps working.
DOMAIN=panel.example.com
ACME_EMAIL=admin@example.com

IMAGE_BACKEND=novium/backend:latest
IMAGE_FRONTEND=novium/frontend:latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=backend

# OAuth/OIDC. AUTH_PROVIDER names the provider in the login route
# (/api/auth/login/<name>) and must match the frontend's VITE_PROVIDERS.
# The redirect url is derived as https://${DOMAIN}/api/auth/callback.
AUTH_PROVIDER=user
AUTH_AUTHORIZE_URL=https://sso.novium.world/oidc/auth
AUTH_TOKEN_URL=https://sso.novium.world/oidc/token
AUTH_USERINFO_URL=https://sso.novium.world/oidc/me
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# All optional, see ../backend/.env.example
CURSEFORGE_API_KEY=
CLOUDFLARE_API_TOKEN=
PANGOLIN_API_URL=
PANGOLIN_API_KEY=
PANGOLIN_ORG_ID=
PANGOLIN_SITE_ID=
